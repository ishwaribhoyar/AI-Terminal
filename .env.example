# IVERI AI Assistant - Environment Configuration
# Copy this file to .env and fill in your settings

# ============================================
# AI CONFIGURATION (Google Gemini Flash)
# ============================================
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# ELEVENLABS TEXT-TO-SPEECH (Flash v2.5)
# ============================================
# Ultra-fast speech synthesis (~75ms latency)
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ============================================
# VOICE & AUDIO SETTINGS
# ============================================
ENABLE_TTS=true
SPEECH_RATE=150
SPEECH_VOLUME=0.9
SPEECH_LANGUAGE=en-US

# ============================================
# OPTIONAL SERVICES
# ============================================
# Picovoice Access Key (For hands-free "Jarvis" wake word)
# Free tier at: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your-picovoice-access-key-here

# OpenWeatherMap API Key (Optional)
# (Note: IVERI has a free built-in weather fallback if omitted)
WEATHER_API_KEY=your-openweathermap-api-key-here

# NewsAPI Key (Optional)
NEWS_API_KEY=your-newsapi-key-here
